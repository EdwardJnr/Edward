# Postgres connection string. For Supabase use the pooled "Transaction" URL from
# Project Settings → Database. Locally, any Postgres 15+ works.
DATABASE_URL=postgres://user:password@localhost:5432/katungo

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Password the studio team uses to sign in
APP_PASSWORD=

# Random string of at least 32 characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=
