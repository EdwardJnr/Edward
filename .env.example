# Database. SQLite for local work; switch the provider in prisma/schema.prisma to "postgresql" for production.
DATABASE_URL="file:./dev.db"

# Public address of the app, used for Paynow return links and the chatbot embed code.
APP_URL="http://localhost:3000"

# Long random string. Encrypts stored mailbox passwords. Generate with: openssl rand -hex 32
APP_SECRET=""

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=""

# Paynow Zimbabwe integration (Paynow dashboard → Receive Payments → Create Shop)
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
# Email registered on your Paynow account; required for EcoCash/OneMoney payments in test mode.
PAYNOW_AUTH_EMAIL=""

# Protects the scheduled endpoints (/api/cron/*). Generate with: openssl rand -hex 32
CRON_SECRET=""

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="edward@katungo.com"
SEED_ADMIN_PASSWORD=""
